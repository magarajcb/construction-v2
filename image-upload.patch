+// Shrink big phone/camera photos before uploading so they stay well under the size limit.
+async function prepareImage(file: File): Promise<File> {
+  if (file.type === "image/gif") return file;
+
+  try {
+    const bitmap = await createImageBitmap(file);
+    const scale = Math.min(1, MAX_IMAGE_SIDE / Math.max(bitmap.width, bitmap.height));
+
+    if (scale === 1 && file.size <= 1.5 * 1024 * 1024) {
+      bitmap.close();
+      return file;
+    }
+
+    const canvas = document.createElement("canvas");
+    canvas.width = Math.round(bitmap.width * scale);
+    canvas.height = Math.round(bitmap.height * scale);
+
+    const ctx = canvas.getContext("2d");
+    if (!ctx) return file;
+
+    ctx.fillStyle = "#ffffff";
+    ctx.fillRect(0, 0, canvas.width, canvas.height);
+    ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
+    bitmap.close();
+
+    const blob = await new Promise<Blob | null>((resolve) =>
+      canvas.toBlob(resolve, "image/jpeg", 0.85),
+    );
+
+    if (!blob || blob.size >= file.size) return file;
+
+    return new File([blob], file.name.replace(/\.[^.]+$/, "") + ".jpg", {
+      type: "image/jpeg",
+    });
+  } catch {
+    return file;
+  }
+}
+
+async function uploadImage(original: File): Promise<string> {
+  const file = await prepareImage(original);
+
+  if (file.size > MAX_UPLOAD_BYTES) {
+    throw new Error(`${original.name} is too large (maximum 4 MB)`);
+  }
+
+  const body = new FormData();
+  body.append("file", file);
+
+  const response = await fetch("/api/uploads", { method: "POST", body });
+  const data = await response.json().catch(() => ({}));
+
+  if (!response.ok) {
+    throw new Error(data.message || `Failed to upload ${original.name}`);
+  }
+
+  return data.url as string;
+}
